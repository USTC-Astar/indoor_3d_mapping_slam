Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Accumulated 3D Map1
        - /Cartographer Submaps1
        - /Cartographer Trajectory1
        - /Robot View1
      Splitter Ratio: 0.6
    Tree Height: 650
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.28
      Cell Size: 1
      Class: rviz/Grid
      Color: 120; 124; 128
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: true
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.28
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
      Name: RobotModel
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 0.18
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: false
      Name: 2D Projection
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: false
    - Class: Submaps
      Enabled: true
      Name: Cartographer Submaps
      Submap query service: /submap_query
      Topic: /submap_list
      Tracking frame: base_link
      Unreliable: false
      Value: true
    - Alpha: 0.82
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 60; 220; 255
      Color Transformer: Intensity
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Intensity: 1
      Max Color: 255; 255; 255
      Min Intensity: 0
      Min Color: 0; 0; 0
      Name: Accumulated 3D Map
      Position Transformer: XYZ
      Queue Size: 20
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.035
      Style: Points
      Topic: /map_points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true
    - Alpha: 0.45
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 255; 190; 80
      Color Transformer: FlatColor
      Decay Time: 4
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: Live 3D Scan
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.03
      Style: Points
      Topic: /points2
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /trajectory_node_list
      Name: Cartographer Trajectory
      Namespaces: {}
      Queue Size: 10
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /constraint_list
      Name: Cartographer Constraints
      Namespaces: {}
      Queue Size: 10
      Value: false
    - Class: rviz/LaserScan
      Alpha: 0.55
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Color: 255; 184; 72
      Color Transformer: FlatColor
      Decay Time: 2
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Min Color: 0; 0; 0
      Name: 2D Scan
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.025
      Style: Flat Squares
      Topic: /scan
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /active_slam/frontiers
      Name: Active SLAM Frontiers
      Namespaces:
        active_frontiers: true
      Queue Size: 10
      Value: true
    - Class: rviz/Path
      Alpha: 0.95
      Buffer Length: 1
      Color: 255; 185; 40
      Enabled: true
      Head Diameter: 0.2
      Head Length: 0.3
      Length: 0.3
      Line Style: Lines
      Line Width: 0.04
      Name: Active SLAM Path
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Pose Color: 255; 170; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.2
      Topic: /active_slam/path
      Unreliable: false
      Value: true
    - Class: rviz/Pose
      Alpha: 1
      Axes Length: 0.5
      Axes Radius: 0.05
      Color: 255; 80; 40
      Enabled: true
      Head Length: 0.3
      Head Radius: 0.1
      Name: Active SLAM Target
      Shaft Length: 0.8
      Shaft Radius: 0.05
      Shape: Arrow
      Topic: /active_slam/target
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /robot_view/yolo/image_annotated
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Robot View
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 50; 52
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 13
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.8
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.85
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.72
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 000000ff00000000fd0000000100000000000001180000044cfc0200000002fb000000100044006900730070006c00610079007301000000000000032f0000002c00fffffffb000000140052006f0062006f0074002000560069006500770100000335000001170000002c00ffffff000006e40000044c00000004000000040000000800000008fc00000000
  Robot View:
    collapsed: false
  Width: 1800
  X: 50
  Y: 50
