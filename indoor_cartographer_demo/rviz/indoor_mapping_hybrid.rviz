Panels:
  - Class: rviz/Displays
    Help Height: 78
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /2D Navigation Map1
        - /3D OctoMap1
        - /Robot View1
      Splitter Ratio: 0.58
    Tree Height: 650
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.24
      Cell Size: 1
      Class: rviz/Grid
      Color: 112; 118; 124
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Ground Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 80
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz/TF
      Enabled: false
      Frame Timeout: 15
      Frames:
        All Enabled: true
      Marker Scale: 0.25
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: false
    - Alpha: 1
      Class: rviz/RobotModel
      Collision Enabled: false
      Enabled: true
      Links:
        All Links Enabled: true
        Expand Joint Details: false
        Expand Link Details: false
        Expand Tree: false
      Name: Robot
      Robot Description: robot_description
      TF Prefix: ""
      Update Interval: 0
      Value: true
      Visual Enabled: true
    - Alpha: 0.48
      Class: rviz/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: 2D Navigation Map
      Topic: /map
      Unreliable: false
      Use Timestamp: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /occupied_cells_vis_array
      Name: 3D OctoMap
      Namespaces:
        map: true
      Queue Size: 10
      Value: true
    - Alpha: 0.65
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz/PointCloud2
      Color: 80; 210; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 80; 60
      Min Color: 40; 110; 255
      Name: OctoMap Voxel Centers
      Position Transformer: XYZ
      Queue Size: 10
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.08
      Style: Boxes
      Topic: /octomap_point_cloud_centers
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: false
    - Class: rviz/Path
      Alpha: 0.95
      Buffer Length: 1
      Color: 255; 190; 45
      Enabled: true
      Head Diameter: 0.2
      Head Length: 0.3
      Length: 0.3
      Line Style: Lines
      Line Width: 0.04
      Name: Active Exploration Path
      Offset:
        X: 0
        Y: 0
        Z: 0.08
      Pose Color: 255; 170; 0
      Pose Style: None
      Radius: 0.03
      Shaft Diameter: 0.1
      Shaft Length: 0.2
      Topic: /active_slam/path
      Unreliable: false
      Value: true
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /active_slam/frontiers
      Name: Exploration Frontiers
      Namespaces:
        active_frontiers: true
      Queue Size: 10
      Value: false
    - Class: rviz/Pose
      Alpha: 1
      Axes Length: 0.4
      Axes Radius: 0.04
      Color: 255; 82; 42
      Enabled: true
      Head Length: 0.25
      Head Radius: 0.08
      Name: Current Target
      Shaft Length: 0.65
      Shaft Radius: 0.04
      Shape: Arrow
      Topic: /active_slam/target
      Unreliable: false
      Value: true
    - Class: rviz/Image
      Enabled: true
      Image Topic: /robot_view/image_raw
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Robot View
      Normalize Range: true
      Queue Size: 2
      Transport Hint: raw
      Unreliable: false
      Value: true
  Enabled: true
  Global Options:
    Background Color: 45; 48; 52
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 14
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.75
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.82
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 0.72
    Saved: ~
Window Geometry:
  Displays:
    collapsed: false
  Height: 1080
  Hide Left Dock: false
  Hide Right Dock: true
  Robot View:
    collapsed: false
  Width: 1800
  X: 50
  Y: 50
