<?xml version="1.0"?>
<robot name="indoor_mapper_bot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="enable_3d_sensors" default="false" />

  <xacro:property name="base_length" value="0.28" />
  <xacro:property name="base_width" value="0.19" />
  <xacro:property name="base_height" value="0.11" />
  <xacro:property name="wheel_radius" value="0.055" />
  <xacro:property name="wheel_width" value="0.03" />
  <xacro:property name="wheel_y" value="0.125" />

  <link name="base_footprint" />

  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint" />
    <child link="base_link" />
    <origin xyz="0 0 0" />
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.042" />
      <mass value="4.0" />
      <inertia ixx="0.026" ixy="0" ixz="0" iyy="0.032" iyz="0" izz="0.040" />
    </inertial>
    <visual>
      <origin xyz="0 0 ${base_height / 2.0}" />
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
      <material name="body_teal">
        <color rgba="0.05 0.36 0.40 1" />
      </material>
    </visual>
    <collision name="base_collision">
      <origin xyz="0 0 ${base_height / 2.0 + 0.012}" />
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}" />
      </geometry>
    </collision>
  </link>

  <link name="left_wheel_link">
    <inertial>
      <mass value="0.22" />
      <inertia ixx="0.00045" ixy="0" ixz="0" iyy="0.00045" iyz="0" izz="0.00045" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <material name="wheel_black">
        <color rgba="0.02 0.02 0.02 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
    </collision>
  </link>

  <link name="right_wheel_link">
    <inertial>
      <mass value="0.22" />
      <inertia ixx="0.00045" ixy="0" ixz="0" iyy="0.00045" iyz="0" izz="0.00045" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
      <material name="wheel_black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="1.57079632679 0 0" />
      <geometry>
        <cylinder radius="${wheel_radius}" length="${wheel_width}" />
      </geometry>
    </collision>
  </link>

  <link name="caster_link">
    <inertial>
      <mass value="0.1" />
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001" />
    </inertial>
    <visual>
      <geometry>
        <sphere radius="0.024" />
      </geometry>
      <material name="wheel_black" />
    </visual>
    <collision name="left_rear_support_collision">
      <origin xyz="0 0.060 -0.006" />
      <geometry>
        <sphere radius="0.018" />
      </geometry>
    </collision>
    <collision name="right_rear_support_collision">
      <origin xyz="0 -0.060 -0.006" />
      <geometry>
        <sphere radius="0.018" />
      </geometry>
    </collision>
  </link>

  <link name="laser_link">
    <inertial>
      <mass value="0.2" />
      <inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0004" />
    </inertial>
    <visual>
      <geometry>
        <cylinder radius="0.038" length="0.035" />
      </geometry>
      <material name="laser_copper">
        <color rgba="0.95 0.48 0.12 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <cylinder radius="0.038" length="0.035" />
      </geometry>
    </collision>
  </link>

  <link name="camera_link">
    <inertial>
      <mass value="0.05" />
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002" />
    </inertial>
    <visual>
      <geometry>
        <box size="0.035 0.055 0.035" />
      </geometry>
      <material name="camera_black">
        <color rgba="0.01 0.01 0.01 1" />
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.035 0.055 0.035" />
      </geometry>
    </collision>
  </link>

  <xacro:if value="$(arg enable_3d_sensors)">
    <link name="imu_link">
      <inertial>
        <mass value="0.02" />
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001" />
      </inertial>
      <visual>
        <geometry>
          <box size="0.035 0.028 0.012" />
        </geometry>
        <material name="imu_gray">
          <color rgba="0.18 0.20 0.22 1" />
        </material>
      </visual>
    </link>

    <link name="laser3d_link">
      <inertial>
        <mass value="0.18" />
        <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0003" />
      </inertial>
      <visual>
        <geometry>
          <cylinder radius="0.034" length="0.045" />
        </geometry>
        <material name="laser3d_blue">
          <color rgba="0.10 0.22 0.95 1" />
        </material>
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.034" length="0.045" />
        </geometry>
      </collision>
    </link>
  </xacro:if>

  <link name="left_wing_link">
    <inertial><mass value="0.015" /><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00003" /></inertial>
    <visual><geometry><box size="0.14 0.055 0.012" /></geometry><material name="wing_sky"><color rgba="0.20 0.72 0.95 1" /></material></visual>
  </link>

  <link name="right_wing_link">
    <inertial><mass value="0.015" /><inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00003" /></inertial>
    <visual><geometry><box size="0.14 0.055 0.012" /></geometry><material name="wing_sky" /></visual>
  </link>

  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="left_wheel_link" />
    <origin xyz="0 ${wheel_y} ${wheel_radius}" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link" />
    <child link="right_wheel_link" />
    <origin xyz="0 -${wheel_y} ${wheel_radius}" />
    <axis xyz="0 1 0" />
  </joint>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link" />
    <child link="caster_link" />
    <origin xyz="-0.105 0 0.024" />
  </joint>

  <joint name="laser_joint" type="fixed">
    <parent link="base_link" />
    <child link="laser_link" />
    <origin xyz="0.065 0 0.16" />
  </joint>

  <joint name="camera_joint" type="fixed">
    <parent link="base_link" />
    <child link="camera_link" />
    <origin xyz="0.15 0 0.23" />
  </joint>

  <xacro:if value="$(arg enable_3d_sensors)">
    <joint name="imu_joint" type="fixed">
      <parent link="base_link" />
      <child link="imu_link" />
      <origin xyz="0.0 0 0.205" />
    </joint>

    <joint name="laser3d_joint" type="fixed">
      <parent link="base_link" />
      <child link="laser3d_link" />
      <origin xyz="0.03 0 0.285" />
    </joint>
  </xacro:if>

  <joint name="left_wing_joint" type="fixed">
    <parent link="base_link" /><child link="left_wing_link" />
    <origin xyz="-0.015 0.105 0.145" rpy="0 0 0.45" />
  </joint>

  <joint name="right_wing_joint" type="fixed">
    <parent link="base_link" /><child link="right_wing_link" />
    <origin xyz="-0.015 -0.105 0.145" rpy="0 0 -0.45" />
  </joint>

  <gazebo reference="base_footprint">
    <sensor type="contact" name="base_contact_sensor">
      <always_on>true</always_on>
      <update_rate>40</update_rate>
      <contact>
        <collision>base_footprint_fixed_joint_lump__base_collision_collision</collision>
      </contact>
      <plugin name="gazebo_ros_bumper" filename="libgazebo_ros_bumper.so">
        <robotNamespace>/</robotNamespace>
        <bumperTopicName>bumper</bumperTopicName>
        <frameName>base_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo reference="base_link">
    <material>Gazebo/Green</material>
    <gravity>false</gravity>
  </gazebo>

  <gazebo reference="left_wheel_link">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>320000.0</kp>
    <kd>240.0</kd>
    <maxVel>0.04</maxVel>
    <minDepth>0.0005</minDepth>
  </gazebo>

  <gazebo reference="right_wheel_link">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <kp>320000.0</kp>
    <kd>240.0</kd>
    <maxVel>0.04</maxVel>
    <minDepth>0.0005</minDepth>
  </gazebo>

  <gazebo reference="caster_link">
    <material>Gazebo/Black</material>
    <gravity>false</gravity>
    <mu1>0.08</mu1>
    <mu2>0.08</mu2>
    <kp>180000.0</kp>
    <kd>260.0</kd>
    <maxVel>0.03</maxVel>
    <minDepth>0.0005</minDepth>
  </gazebo>

  <gazebo reference="left_wing_link"><material>Gazebo/SkyBlue</material></gazebo>
  <gazebo reference="right_wing_link"><material>Gazebo/SkyBlue</material></gazebo>

  <gazebo reference="laser_link">
    <material>Gazebo/Orange</material>
    <sensor type="ray" name="indoor_mapper_laser">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>12</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159265359</min_angle>
            <max_angle>3.14159265359</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.12</min>
          <max>12.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_laser" filename="libgazebo_ros_laser.so">
        <robotNamespace>/</robotNamespace>
        <topicName>scan</topicName>
        <frameName>laser_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <xacro:if value="$(arg enable_3d_sensors)">
    <gazebo reference="imu_link">
      <material>Gazebo/DarkGrey</material>
      <sensor type="imu" name="indoor_mapper_imu_sensor">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <visualize>false</visualize>
      </sensor>
    </gazebo>

    <gazebo reference="laser3d_link">
      <material>Gazebo/Blue</material>
      <sensor type="ray" name="indoor_mapper_block_laser_3d">
        <pose>0 0 0 0 0 0</pose>
        <visualize>false</visualize>
        <always_on>true</always_on>
        <update_rate>8</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>240</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle>
              <max_angle>3.14159265359</max_angle>
            </horizontal>
            <vertical>
              <samples>24</samples>
              <resolution>1</resolution>
              <min_angle>-0.35</min_angle>
              <max_angle>0.45</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.18</min>
            <max>6.0</max>
            <resolution>0.025</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.0</stddev>
          </noise>
        </ray>
        <plugin name="indoor_mapper_block_laser_3d_controller" filename="libgazebo_ros_block_laser.so">
          <topicName>/block_laser_3d</topicName>
          <frameName>laser3d_link</frameName>
          <gaussianNoise>0.0</gaussianNoise>
          <updateRate>8</updateRate>
        </plugin>
      </sensor>
    </gazebo>

    <gazebo>
      <plugin name="indoor_mapper_imu" filename="libgazebo_ros_imu.so">
        <alwaysOn>true</alwaysOn>
        <bodyName>imu_link</bodyName>
        <frameName>imu_link</frameName>
        <topicName>imu_raw</topicName>
        <serviceName>imu_service</serviceName>
        <gaussianNoise>0.0</gaussianNoise>
        <updateRate>100</updateRate>
      </plugin>
    </gazebo>
  </xacro:if>

  <gazebo reference="camera_link">
    <material>Gazebo/Black</material>
    <sensor type="camera" name="robot_view_camera">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>15</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>640</width>
          <height>480</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.05</near>
          <far>20.0</far>
        </clip>
      </camera>
      <plugin name="gazebo_ros_robot_view_camera" filename="libgazebo_ros_camera.so">
        <robotNamespace>/</robotNamespace>
        <cameraName>robot_view</cameraName>
        <imageTopicName>image_raw</imageTopicName>
        <cameraInfoTopicName>camera_info</cameraInfoTopicName>
        <frameName>camera_link</frameName>
      </plugin>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin name="indoor_mapper_planar_drive" filename="libgazebo_ros_planar_move.so">
      <robotNamespace>/</robotNamespace>
      <alwaysOn>true</alwaysOn>
      <updateRate>50</updateRate>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryRate>50</odometryRate>
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
    </plugin>
  </gazebo>
</robot>
