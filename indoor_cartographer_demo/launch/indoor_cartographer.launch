<launch>
  <arg name="gui" default="true" />
  <arg name="rviz" default="true" />
  <arg name="autonomous" default="true" />
  <arg name="slam_mode" default="2d" />
  <arg name="active_slam" default="$(arg autonomous)" />
  <arg name="waypoint_mapping" default="false" />
  <arg name="explore" default="false" />
  <arg name="navigation" default="false" />
  <arg name="scene" default="detailed" />
  <arg name="enable_3d_sensors" default="$(eval 'true' if arg('slam_mode') == '3d' or arg('slam_mode') == 'hybrid' else 'false')" />
  <arg name="cartographer_3d" default="$(eval 'true' if arg('slam_mode') == '3d' else 'false')" />
  <arg name="octomap_mapping" default="$(eval 'true' if arg('slam_mode') == 'hybrid' else 'false')" />
  <arg name="cartographer_config" default="$(eval 'cartographer_indoor_3d.lua' if arg('slam_mode') == '3d' else ('cartographer_indoor_hybrid.lua' if arg('slam_mode') == 'hybrid' else 'cartographer_indoor_2d.lua'))" />
  <arg name="rviz_config" default="$(eval 'indoor_mapping_3d.rviz' if arg('slam_mode') == '3d' else ('indoor_mapping_hybrid.rviz' if arg('slam_mode') == 'hybrid' else 'indoor_mapping.rviz'))" />
  <arg name="waypoints" default="$(eval '-4.4,-3.25;-3.2,-3.20;-1.0,-2.65;0.8,-1.35;2.6,-1.35;4.4,-1.20;4.65,-3.65;3.25,-3.65;4.65,-3.65;4.4,-1.20;4.0,0.45;3.9,1.35;4.1,2.20;3.45,3.55;4.1,2.20;3.9,1.35;3.8,-1.35;1.0,-1.35;0.2,0.4;0.2,1.35;1.55,2.0;1.55,3.65;1.55,2.0;0.2,1.35;0.2,0.4;-3.35,0.4;-3.4,1.45;-2.75,2.35;-2.75,3.65;-3.65,3.65;-2.75,2.35;-3.4,1.45;-3.4,0.35;-3.7,-1.8;-4.4,-3.25' if arg('scene') == 'quick' else '')" />
  <arg name="dynamic_obstacles" default="$(eval 'true' if arg('scene') == 'quick' else 'false')" />
  <arg name="yolo_cat_detector" default="true" />
  <arg name="yolo_model" default="$(env HOME)/falconbot/src/falconbot_perception/models/yolov8n.pt" />
  <arg name="yolo_confidence" default="0.25" />
  <arg name="kitten_speed" default="0.38" />
  <arg name="world" default="$(eval find('indoor_cartographer_demo') + ('/worlds/quick_validation_home.world' if arg('scene') == 'quick' else '/worlds/two_bedroom_apartment.world'))" />
  <arg name="x" default="$(eval '-4.4' if arg('scene') == 'quick' else '-3.0')" />
  <arg name="y" default="$(eval '-3.4' if arg('scene') == 'quick' else '-4.7')" />
  <arg name="z" default="0.025" />
  <arg name="yaw" default="0.0" />

  <param name="/use_sim_time" value="true" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(arg world)" />
    <arg name="gui" value="$(arg gui)" />
    <arg name="paused" value="false" />
    <arg name="use_sim_time" value="true" />
  </include>

  <param name="robot_description"
      command="$(find xacro)/xacro $(dirname)/../urdf/indoor_mapper_bot.urdf.xacro enable_3d_sensors:=$(arg enable_3d_sensors)" />

  <node name="robot_state_publisher" pkg="robot_state_publisher"
      type="robot_state_publisher" output="screen" />

  <node name="indoor_odom_filter" pkg="indoor_cartographer_demo"
      type="indoor_odom_filter.py" output="screen">
    <param name="input_topic" value="/odom" />
    <param name="output_topic" value="/cartographer/odom" />
    <param name="planarize" value="true" />
    <param name="publish_tf" value="false" />
    <param name="odom_frame" value="odom" />
    <param name="base_frame" value="base_footprint" />
  </node>

  <node name="spawn_indoor_mapper_bot" pkg="indoor_cartographer_demo"
      type="indoor_spawn_or_replace_model.py" output="screen">
    <param name="model_name" value="indoor_mapper_bot" />
    <param name="x" value="$(arg x)" />
    <param name="y" value="$(arg y)" />
    <param name="z" value="$(arg z)" />
    <param name="yaw" value="$(arg yaw)" />
  </node>

  <node if="$(arg octomap_mapping)" name="planar_pose_stabilizer"
      pkg="indoor_cartographer_demo" type="planar_pose_stabilizer.py" output="screen">
    <param name="model_name" value="indoor_mapper_bot" />
    <param name="target_z" value="0.025" />
    <param name="update_rate" value="100.0" />
  </node>

  <node if="$(arg dynamic_obstacles)" name="moving_kitten_obstacle"
      pkg="indoor_cartographer_demo" type="moving_kitten_obstacle.py" output="screen">
    <param name="model_name" value="moving_kitten" />
    <param name="speed" value="$(arg kitten_speed)" />
    <param name="update_rate" value="15.0" />
  </node>

  <node if="$(arg yolo_cat_detector)" name="yolo_cat_detector"
      pkg="indoor_cartographer_demo" type="yolo_cat_detector.py" output="screen">
    <param name="image_topic" value="/robot_view/image_raw" />
    <param name="annotated_topic" value="/robot_view/yolo/image_annotated" />
    <param name="status_topic" value="/robot_view/yolo/status" />
    <param name="model_path" value="$(arg yolo_model)" />
    <param name="confidence_threshold" value="$(arg yolo_confidence)" />
    <param name="inference_rate" value="4.0" />
    <param name="hold_seconds" value="0.6" />
  </node>

  <node if="$(arg enable_3d_sensors)" name="pointcloud_to_pointcloud2"
      pkg="indoor_cartographer_demo" type="pointcloud_to_pointcloud2.py" output="screen">
    <param name="input_topic" value="/block_laser_3d" />
    <param name="output_topic" value="/points2" />
    <param name="min_range" value="0.18" />
    <param name="max_range" value="5.85" />
    <param name="max_range_margin" value="0.10" />
    <param name="min_z" value="-0.12" />
    <param name="max_z" value="2.25" />
  </node>

  <node if="$(arg cartographer_3d)" name="imu_frame_republisher"
      pkg="indoor_cartographer_demo" type="imu_frame_republisher.py" output="screen">
    <param name="input_topic" value="/imu_raw" />
    <param name="output_topic" value="/imu" />
    <param name="frame_id" value="base_link" />
    <param name="planar_motion" value="true" />
    <param name="gravity_magnitude" value="9.80665" />
  </node>

  <node if="$(arg cartographer_3d)" name="pointcloud_map_accumulator"
      pkg="indoor_cartographer_demo" type="pointcloud_map_accumulator.py" output="screen">
    <param name="input_topic" value="/points2" />
    <param name="output_topic" value="/map_points" />
    <param name="target_frame" value="odom" />
    <param name="voxel_size" value="0.10" />
    <param name="publish_rate" value="0.5" />
    <param name="max_points" value="750000" />
    <param name="min_z" value="0.08" />
    <param name="max_z" value="2.45" />
    <param name="min_x" value="-20.0" />
    <param name="max_x" value="20.0" />
    <param name="min_y" value="-20.0" />
    <param name="max_y" value="20.0" />
    <param name="allow_latest_tf_fallback" value="false" />
    <param name="freeze_on_completion" value="true" />
    <param name="completion_topic" value="/active_slam/completed" />
  </node>

  <node if="$(arg octomap_mapping)" name="octomap_cloud_filter"
      pkg="indoor_cartographer_demo" type="octomap_cloud_filter.py" output="screen">
    <param name="input_topic" value="/points2" />
    <param name="output_topic" value="/octomap/points_filtered" />
    <param name="completion_topic" value="/active_slam/completed" />
    <param name="sensor_link" value="indoor_mapper_bot::laser3d_link" />
    <param name="base_link" value="indoor_mapper_bot::base_footprint" />
    <param name="sensor_offset_x" value="0.03" />
    <param name="sensor_offset_y" value="0.0" />
    <param name="sensor_offset_z" value="0.285" />
    <rosparam param="dynamic_link_tokens">[moving_kitten]</rosparam>
    <param name="min_range" value="0.24" />
    <param name="max_range" value="5.45" />
    <param name="min_z" value="-0.16" />
    <param name="max_z" value="2.20" />
    <param name="min_world_z" value="0.02" />
    <param name="max_world_z" value="2.48" />
    <param name="ground_filter_max_z" value="0.20" />
    <param name="vertical_support_min_z" value="0.45" />
    <param name="ground_column_size" value="0.15" />
    <param name="voxel_size" value="0.075" />
    <param name="dynamic_filter_radius" value="0.72" />
    <param name="freeze_on_completion" value="true" />
  </node>

  <node if="$(arg octomap_mapping)" name="octomap_server"
      pkg="octomap_server" type="octomap_server_node" output="screen">
    <param name="frame_id" value="map" />
    <param name="resolution" value="0.10" />
    <param name="latch" value="true" />
    <param name="compress_map" value="true" />
    <param name="filter_ground" value="false" />
    <param name="pointcloud_min_z" value="0.02" />
    <param name="pointcloud_max_z" value="2.48" />
    <param name="occupancy_min_z" value="0.02" />
    <param name="occupancy_max_z" value="2.48" />
    <param name="sensor_model/max_range" value="5.45" />
    <param name="sensor_model/hit" value="0.72" />
    <param name="sensor_model/miss" value="0.42" />
    <param name="sensor_model/min" value="0.12" />
    <param name="sensor_model/max" value="0.97" />
    <remap from="cloud_in" to="/octomap/points_filtered" />
  </node>

  <node name="cartographer_node" pkg="cartographer_ros"
      type="cartographer_node" args="
          -configuration_directory $(dirname)/../config
          -configuration_basename $(arg cartographer_config)"
      output="screen">
    <remap from="scan" to="/scan" />
    <remap from="points2" to="/points2" />
    <remap from="imu" to="/imu" />
    <remap from="odom" to="/cartographer/odom" />
  </node>

  <node name="cartographer_occupancy_grid_node" pkg="cartographer_ros"
      type="cartographer_occupancy_grid_node"
      args="-resolution 0.05 -publish_period_sec 0.6"
      output="screen" />

  <node if="$(arg waypoint_mapping)" name="indoor_waypoint_mapper"
      pkg="indoor_cartographer_demo" type="indoor_waypoint_mapper.py" output="screen">
    <param name="waypoints" value="$(arg waypoints)" />
    <param name="odom_topic" value="/cartographer/odom" />
    <param name="loop" value="true" />
    <param name="start_delay" value="3.0" />
    <param name="reached_distance" value="0.44" />
    <param name="max_linear_speed" value="0.24" />
    <param name="max_angular_speed" value="0.62" />
    <param name="align_heading_threshold" value="0.82" />
    <param name="heading_turn_gain" value="0.82" />
    <param name="min_align_angular_speed" value="0.16" />
    <param name="near_pi_hysteresis" value="0.45" />
    <param name="lookahead_distance" value="1.20" />
    <param name="route_search_window" value="8" />
    <param name="path_resolution" value="0.18" />
    <param name="smoothing_passes" value="1" />
    <param name="front_stop_distance" value="0.62" />
    <param name="collision_distance" value="0.28" />
    <param name="side_stop_distance" value="0.34" />
    <param name="costmap_inflation_radius" value="0.38" />
    <param name="costmap_unknown_cost" value="8" />
    <param name="costmap_weight" value="2.5" />
    <param name="use_costmap" value="false" />
    <param name="use_sampling_planner" value="false" />
    <param name="min_tracking_speed" value="0.08" />
    <param name="creep_when_turning" value="true" />
    <param name="turn_creep_speed" value="0.06" />
    <param name="turn_creep_heading_limit" value="1.7" />
    <param name="cmd_smoothing_enabled" value="true" />
    <param name="max_linear_accel" value="0.16" />
    <param name="max_linear_decel" value="0.26" />
    <param name="max_angular_accel" value="0.42" />
    <param name="replan_interval" value="2.0" />
  </node>

  <node if="$(arg navigation)" name="move_base" pkg="move_base" type="move_base" output="screen">
    <remap from="cmd_vel" to="/move_base/cmd_vel_raw" />
    <rosparam file="$(dirname)/../config/costmap_common.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(dirname)/../config/costmap_common.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(dirname)/../config/global_costmap_exploration.yaml" command="load" />
    <rosparam file="$(dirname)/../config/local_costmap.yaml" command="load" />
    <rosparam file="$(dirname)/../config/move_base_exploration.yaml" command="load" />
    <rosparam file="$(dirname)/../config/dwa_exploration.yaml" command="load" />
  </node>

  <node if="$(arg navigation)" name="indoor_cmd_vel_safety"
      pkg="indoor_cartographer_demo" type="indoor_cmd_vel_safety.py" output="screen">
    <param name="max_forward_speed" value="1.15" />
    <param name="max_reverse_speed" value="0.28" />
    <param name="max_angular_speed" value="1.95" />
    <param name="slow_distance" value="0.64" />
    <param name="stop_distance" value="0.38" />
    <param name="emergency_distance" value="0.27" />
    <param name="side_stop_distance" value="0.24" />
    <param name="clear_speed_distance" value="99.0" />
    <param name="speed_boost" value="1.0" />
    <param name="min_clear_speed" value="0.0" />
    <param name="boost_angular_limit" value="0.45" />
    <param name="backup_seconds" value="0.85" />
    <param name="turn_seconds" value="0.75" />
    <param name="stuck_seconds" value="3.0" />
    <param name="stuck_distance" value="0.045" />
  </node>

  <node if="$(arg active_slam)" name="active_slam_explorer"
      pkg="indoor_cartographer_demo" type="active_slam_explorer.py" output="screen">
    <param name="odom_topic" value="/cartographer/odom" />
    <param name="control_rate" value="$(eval '18.0' if arg('slam_mode') == '3d' else ('20.0' if arg('slam_mode') == 'hybrid' else '24.0'))" />
    <param name="replan_interval" value="$(eval '2.8' if arg('slam_mode') == '3d' else ('2.6' if arg('slam_mode') == 'hybrid' else '2.4'))" />
    <param name="goal_timeout" value="$(eval '34.0' if arg('slam_mode') == '3d' else ('26.0' if arg('slam_mode') == 'hybrid' else '20.0'))" />
    <param name="goal_commitment" value="$(eval '9.0' if arg('slam_mode') == '3d' else ('8.5' if arg('slam_mode') == 'hybrid' else '8.0'))" />
    <param name="lookahead_distance" value="$(eval '1.20' if arg('slam_mode') == '3d' else ('1.35' if arg('slam_mode') == 'hybrid' else '1.65'))" />
    <param name="min_local_target_distance" value="0.16" />
    <param name="goal_reached_distance" value="$(eval '0.34' if arg('slam_mode') == '3d' else '0.26')" />
    <param name="frontier_probe_distance" value="$(eval '0.90' if arg('slam_mode') == '3d' else '1.4')" />
    <param name="frontier_probe_seconds" value="$(eval '4.0' if arg('slam_mode') == '3d' else '5.0')" />
    <param name="frontier_probe_speed" value="$(eval '0.20' if arg('slam_mode') == '3d' else '0.42')" />
    <param name="frontier_probe_unknown_radius" value="18" />
    <param name="finish_cartographer_on_complete" value="$(eval 'false' if arg('slam_mode') == '3d' else 'true')" />
    <param name="return_home_on_complete" value="$(eval 'false' if arg('slam_mode') == '3d' or arg('slam_mode') == 'hybrid' else 'true')" />
    <param name="free_threshold" value="$(eval '68' if arg('slam_mode') == '3d' else '35')" />
    <param name="occupied_threshold" value="$(eval '82' if arg('slam_mode') == '3d' else '58')" />
    <param name="inflate_radius" value="$(eval '0.24' if arg('slam_mode') == '3d' else '0.20')" />
    <param name="costmap_radius" value="$(eval '0.54' if arg('slam_mode') == '3d' else '0.46')" />
    <param name="costmap_weight" value="0.10" />
    <param name="min_frontier_cells" value="4" />
    <param name="min_frontier_path_distance" value="0.55" />
    <param name="frontier_gain_weight" value="2.8" />
    <param name="frontier_distance_weight" value="0.36" />
    <param name="frontier_far_bonus" value="0.28" />
    <param name="frontier_goal_hysteresis" value="3.2" />
    <param name="patrol_min_distance" value="$(eval '0.9' if arg('slam_mode') == '3d' else '1.2')" />
    <param name="patrol_max_distance" value="$(eval '5.2' if arg('slam_mode') == '3d' else '6.5')" />
    <param name="patrol_unknown_radius" value="12" />
    <param name="patrol_min_visible_unknown" value="8" />
    <param name="patrol_cell_stride" value="5" />
    <param name="closure_start_ratio" value="0.72" />
    <param name="closure_min_runtime" value="$(eval '90.0' if arg('scene') == 'quick' else '140.0')" />
    <param name="closure_unknown_radius" value="36" />
    <param name="closure_cell_stride" value="5" />
    <param name="closure_min_visible_unknown" value="6" />
    <param name="closure_min_distance" value="0.35" />
    <param name="closure_max_distance" value="8.0" />
    <param name="closure_bbox_margin" value="4" />
    <param name="closure_bounds_min_x" value="$(eval '-1.45' if arg('scene') == 'quick' else '-4.82')" />
    <param name="closure_bounds_min_y" value="$(eval '-0.95' if arg('scene') == 'quick' else '-1.12')" />
    <param name="closure_bounds_max_x" value="$(eval '10.25' if arg('scene') == 'quick' else '10.82')" />
    <param name="closure_bounds_max_y" value="$(eval '7.75' if arg('scene') == 'quick' else '10.52')" />
    <param name="completion_no_frontier_cycles" value="$(eval '8' if arg('slam_mode') == '3d' else '10')" />
    <param name="completion_stable_seconds" value="$(eval '18.0' if arg('slam_mode') == '3d' else ('22.0' if arg('slam_mode') == 'hybrid' else '25.0'))" />
    <param name="completion_min_runtime" value="$(eval ('210.0' if arg('scene') == 'quick' else '300.0') if arg('slam_mode') == '3d' else (('170.0' if arg('scene') == 'quick' else '240.0') if arg('slam_mode') == 'hybrid' else ('140.0' if arg('scene') == 'quick' else '210.0')))" />
    <param name="completion_min_travel_distance" value="$(eval ('28.0' if arg('scene') == 'quick' else '46.0') if arg('slam_mode') == '3d' else (('38.0' if arg('scene') == 'quick' else '60.0') if arg('slam_mode') == 'hybrid' else ('45.0' if arg('scene') == 'quick' else '70.0')))" />
    <param name="completion_min_known_cells" value="$(eval ('28000' if arg('scene') == 'quick' else '52000') if arg('slam_mode') == '3d' else ('35000' if arg('scene') == 'quick' else '60000'))" />
    <param name="completion_max_interior_unknown" value="$(eval ('9800' if arg('scene') == 'quick' else '13500') if arg('slam_mode') == '3d' else ('6200' if arg('scene') == 'quick' else '10800'))" />
    <param name="completion_known_growth_cells" value="20" />
    <param name="visit_record_distance" value="0.75" />
    <param name="home_reached_distance" value="0.48" />
    <param name="home_timeout" value="90.0" />
    <param name="cruise_speed" value="$(eval '0.28' if arg('slam_mode') == '3d' else ('0.40' if arg('slam_mode') == 'hybrid' else '0.82'))" />
    <param name="min_drive_speed" value="$(eval '0.10' if arg('slam_mode') == '3d' else ('0.13' if arg('slam_mode') == 'hybrid' else '0.30'))" />
    <param name="max_angular_speed" value="$(eval '0.72' if arg('slam_mode') == '3d' else ('0.90' if arg('slam_mode') == 'hybrid' else '2.05'))" />
    <param name="turn_gain" value="$(eval '0.95' if arg('slam_mode') == '3d' else ('1.12' if arg('slam_mode') == 'hybrid' else '2.05'))" />
    <param name="local_heading_samples" value="21" />
    <param name="local_heading_limit" value="1.45" />
    <param name="local_clear_distance" value="1.45" />
    <param name="local_stop_margin" value="0.14" />
    <param name="obstacle_clearance_weight" value="1.45" />
    <param name="heading_tracking_weight" value="2.15" />
    <param name="front_slow_distance" value="$(eval '0.88' if arg('slam_mode') == '3d' else ('0.92' if arg('slam_mode') == 'hybrid' else '1.00'))" />
    <param name="front_stop_distance" value="$(eval '0.42' if arg('slam_mode') == '3d' else ('0.40' if arg('slam_mode') == 'hybrid' else '0.36'))" />
    <param name="emergency_distance" value="$(eval '0.28' if arg('slam_mode') == '3d' else ('0.27' if arg('slam_mode') == 'hybrid' else '0.24'))" />
    <param name="side_stop_distance" value="$(eval '0.27' if arg('slam_mode') == '3d' else ('0.26' if arg('slam_mode') == 'hybrid' else '0.23'))" />
    <param name="rear_stop_distance" value="0.24" />
    <param name="robot_half_width" value="0.15" />
    <param name="robot_front_radius" value="0.16" />
    <param name="laser_offset_x" value="0.065" />
    <param name="corridor_margin" value="0.04" />
    <param name="scan_self_filter_radius" value="0.13" />
    <param name="blocked_timeout" value="1.8" />
    <param name="stuck_timeout" value="2.8" />
    <param name="cmd_smoothing_enabled" value="$(eval 'true' if arg('slam_mode') == '3d' or arg('slam_mode') == 'hybrid' else 'false')" />
    <param name="max_linear_accel" value="$(eval '0.14' if arg('slam_mode') == '3d' else ('0.16' if arg('slam_mode') == 'hybrid' else '0.40'))" />
    <param name="max_linear_decel" value="$(eval '0.22' if arg('slam_mode') == '3d' else ('0.28' if arg('slam_mode') == 'hybrid' else '0.70'))" />
    <param name="max_angular_accel" value="$(eval '0.72' if arg('slam_mode') == '3d' else ('0.78' if arg('slam_mode') == 'hybrid' else '2.20'))" />
    <param name="backup_seconds" value="$(eval '0.85' if arg('slam_mode') == '3d' else ('0.92' if arg('slam_mode') == 'hybrid' else '1.05'))" />
    <param name="backup_speed" value="$(eval '0.14' if arg('slam_mode') == '3d' else ('0.20' if arg('slam_mode') == 'hybrid' else '0.30'))" />
    <param name="recovery_turn_speed" value="$(eval '0.58' if arg('slam_mode') == '3d' else ('0.82' if arg('slam_mode') == 'hybrid' else '1.25'))" />
    <param name="turn_seconds" value="$(eval '1.05' if arg('slam_mode') == '3d' else '1.15')" />
    <param name="probe_seconds" value="$(eval '0.70' if arg('slam_mode') == '3d' else '0.90')" />
    <param name="dead_end_front_distance" value="0.52" />
    <param name="dead_end_side_distance" value="0.45" />
    <param name="dead_end_backup_extra" value="0.55" />
    <param name="spin_timeout" value="5.0" />
    <param name="spin_min_angle" value="3.6" />
    <param name="spin_max_translation" value="0.35" />
  </node>

  <node if="$(arg explore)" name="explore"
      pkg="explore_lite" type="explore" respawn="false" output="screen">
    <param name="robot_base_frame" value="base_link" />
    <param name="costmap_topic" value="/move_base/global_costmap/costmap" />
    <param name="costmap_updates_topic" value="/move_base/global_costmap/costmap_updates" />
    <param name="visualize" value="true" />
    <param name="planner_frequency" value="0.35" />
    <param name="progress_timeout" value="22.0" />
    <param name="potential_scale" value="0.45" />
    <param name="orientation_scale" value="0.0" />
    <param name="gain_scale" value="2.4" />
    <param name="transform_tolerance" value="0.5" />
    <param name="min_frontier_size" value="0.28" />
    <param name="minimum_goal_distance" value="1.0" />
    <param name="subgoal_distance" value="4.0" />
    <param name="plan_tolerance" value="0.85" />
    <param name="check_path_before_goal" value="true" />
  </node>

  <node if="$(arg rviz)" name="rviz" pkg="rviz" type="rviz"
      args="-d $(dirname)/../rviz/$(arg rviz_config)" />
</launch>
